# LLM Wiki Agent Configuration
# =================================

# DeepSeek API 配置
# -----------------
# DeepSeek 提供 OpenAI 兼容的 API
# 也可在 Web UI（Tools → LLM Settings）中配置；页面保存的值优先，环境变量作回退
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=your-api-key-here

# Model Configuration
# -------------------
# 核心任务使用的模型（ingest、query、lint）
# DeepSeek 推荐模型：deepseek-chat (33B) 或 deepseek-r1-chat (70B)
# 页面「Model」字段对应此项；DB 非空时覆盖环境变量
LLM_MODEL=deepseek-v4-flash

# 快速任务使用的模型（图构建、页面选择）
# DeepSeek 轻量模型：deepseek-chat (33B) 或 deepseek-coder
# 页面「Fast Model」字段对应此项；DB 非空时覆盖环境变量
LLM_MODEL_FAST=deepseek-v4-flash

# litellm 配置
# ------------
# 启用详细日志（调试时使用）
# LITELLM_LOG=True

# Langfuse tracing（可选）。密钥齐全且配置了地址时，LLM 调用会上报到 Langfuse。
# LiteLLM 读取 LANGFUSE_HOST；若只设置 LANGFUSE_BASE_URL，启动时会自动映射。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://127.0.0.1:3000

# 服务端口配置
# ------------
# FastAPI (uvicorn) 服务端口
API_PORT=5000
# MCP Streamable HTTP 服务端口
MCP_PORT=8081
# CORS 允许来源（逗号分隔）。空或未设置 = *（全开，与历史行为一致）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MCP Host 白名单（逗号分隔）。跨 Docker 容器访问时必配宿主机 IP / 服务名，
# 否则会返回 421 Invalid Host header。示例：192.168.7.203,backend
# MCP_ALLOWED_HOSTS=192.168.7.203,host.docker.internal
# 仅在可信内网/Docker 环境可关闭 DNS 重绑定防护：MCP_DNS_REBINDING_PROTECTION=0
